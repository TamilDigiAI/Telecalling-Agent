# ==============================================================================
# DigiAnchorZ Voice SaaS — Environment Configuration (Placeholder Values Only)
# Copy to .env.local for local development. Never commit real secrets.
# ==============================================================================

# --- [Shared] Runtime Mode, URLs & Timezone ---
APP_MODE=mock
TELEPHONY_PROVIDER_MODE=mock
APP_BASE_URL=http://localhost:3000
VOICE_PUBLIC_BASE_URL=
N8N_BASE_URL=
APP_TIMEZONE=Asia/Kolkata
DEFAULT_WORKSPACE_SLUG=digianchorz
DEFAULT_WORKSPACE_NAME=DigiAnchorZ
VOICE_AGENT_NAME=Nila

# --- [Voice & CRM] Vobiz Outbound/Inbound Telephony ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_API_BASE_URL=https://api.vobiz.ai
VOBIZ_APP_ID=

# --- [Shared] Sarvam Speech & Dialogue Pipeline (Agent Nila · Voice: Ritu) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_LANGUAGE=ta-IN
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations
LLM_BASE_URL=https://api.sarvam.ai/v1

# --- [CRM] Supabase Auth & Postgres CRM (@supabase/ssr) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here
FOUNDER_LOGIN_EMAIL=founder@digianchorz.com
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- [Shared] Internal Service Auth & n8n Webhook Auth ---
VOICE_INTERNAL_SHARED_SECRET=replace_with_32_byte_hex_internal_secret
VOICE_CALLBACK_SIGNING_SECRET=replace_with_32_byte_hex_callback_secret
N8N_WEBHOOK_SECRET=replace_with_32_byte_hex_n8n_secret
N8N_API_KEY=

# --- [CRM] Google Sheets Lead Intake & Write-Back ---
GOOGLE_SHEET_ID=1X9sQhlRx_7jo1c6gZ8SBxNas5aqqRjgAY0-UzOUB97A
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1X9sQhlRx_7jo1c6gZ8SBxNas5aqqRjgAY0-UzOUB97A/edit?usp=sharing
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- [Safety] Pilot Safety & Queue Guards (Disabled by Default) ---
OUTBOUND_DIALING_ENABLED=false
SHEETS_QUEUE_ENABLED=false
DIAL_ATTEMPT_CAP=3
DIAL_COOLDOWN_MINUTES=120
DIAL_ALLOWED_START_HOUR_IST=9
DIAL_ALLOWED_END_HOUR_IST=20
DIAL_PAUSE_SWITCH=false

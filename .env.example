# ==============================================================================
# DigiAnchorZ Voice SaaS — Environment Configuration (Placeholder Values Only)
# Copy to .env.local for local development. Never commit real secrets.
#Each section documents which service reads each variable:
#  - [CRM - Vercel]         Read by Next.js Founder CRM on Vercel
#  - [Voice - Cloud Run]    Read by Nila Voice Service on Cloud Run (asia-south1)
#  - [Shared]               Read by both Vercel CRM and Cloud Run Voice Service
# ==============================================================================

# --- [Shared] Runtime Mode, URLs & Timezone ---
APP_MODE=mock
TELEPHONY_PROVIDER_MODE=mock
APP_BASE_URL=http://localhost:3000
VOICE_PUBLIC_BASE_URL=https://nila-voice-placeholder.a.run.app
APP_TIMEZONE=Asia/Kolkata
DEFAULT_WORKSPACE_SLUG=digianchorz
DEFAULT_WORKSPACE_NAME=DigiAnchorZ
VOICE_AGENT_NAME=Nila

# --- [CRM - Vercel] Supabase Auth & Postgres CRM (@supabase/ssr) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret key (used by CRM server workers & founder bootstrap):
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here
FOUNDER_LOGIN_EMAIL=founder@digianchorz.com
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# --- [Shared] Direct Postgres / Internal Service Auth ---
# DATABASE_URL is required only for migrations or if the voice worker connects directly to Postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# Shared HMAC-SHA256 secret used by Vercel CRM to authenticate requests to Cloud Run /internal/dial
VOICE_INTERNAL_SHARED_SECRET=replace_with_32_byte_hex_internal_secret
# HMAC-SHA256 secret used by Cloud Run to sign/verify per-attempt Exotel status & WSS stream tokens
VOICE_CALLBACK_SIGNING_SECRET=replace_with_32_byte_hex_callback_secret

# --- [CRM - Vercel] Google Sheets Lead Intake & Write-Back ---
GOOGLE_CLOUD_PROJECT=solid-mountain-514506-a8
GOOGLE_SHEET_ID=1X9sQhlRx_7jo1c6gZ8SBxNas5aqqRjgAY0-UzOUB97A
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1X9sQhlRx_7jo1c6gZ8SBxNas5aqqRjgAY0-UzOUB97A/edit?usp=sharing
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=nila-voice-sa@solid-mountain-514506-a8.iam.gserviceaccount.com

# --- [Voice - Cloud Run & CRM] Exotel India Telephony ---
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_CALLER_ID=08047100000
EXOTEL_CALL_MODE=connect_voice_ai
EXOTEL_FLOW_ID=your_exotel_flow_id
# Server-side Secret Manager secrets on Cloud Run:
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token

# --- [Shared] Sarvam Speech & Dialogue Pipeline (Agent Nila) ---
# Server-side Secret Manager secret on Cloud Run & Vercel server-only env:
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_LANGUAGE=ta-IN
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations
LLM_BASE_URL=https://api.sarvam.ai/v1

# --- [Voice - Cloud Run & CRM] Pilot Safety & Queue Guards (Disabled by Default) ---
OUTBOUND_DIALING_ENABLED=false
SHEETS_QUEUE_ENABLED=false
DIAL_ATTEMPT_CAP=3
DIAL_COOLDOWN_MINUTES=120
DIAL_ALLOWED_START_HOUR_IST=9
DIAL_ALLOWED_END_HOUR_IST=20
DIAL_PAUSE_SWITCH=false
